'name': 'Vue.js'
'scopeName': 'source.vue'
'fileTypes': [
  'vue'
]
'patterns': [
  {
    'begin': '<!--'
    'end': '-->'
    'name': 'comment.block.html.vue'
  }
  {
    'begin': '<(template|script|style)(\\s+(?:lang|src|scoped|module)="[^"]*")*\\s*>'
    'beginCaptures':
      '1':
        'name': 'entity.name.tag.vue'
    'end': '</(template|script|style)>'
    'endCaptures':
      '1':
        'name': 'entity.name.tag.vue'
    'patterns': [
      {
        'include': '$self'
      }
    ]
  }
  {
    'begin': '<(/)?'
    'beginCaptures':
      '1':
        'name': 'punctuation.definition.tag.vue'
      '2':
        'name': 'punctuation.definition.tag.vue'
    'end': '(>)'
    'endCaptures':
      '1':
        'name': 'punctuation.definition.tag.vue'
    'patterns': [
      {
        'match': '\\b[a-zA-Z][a-zA-Z0-9-]*\\b'
        'name': 'entity.name.tag.vue'
      }
      {
        'match': '\\b(@[a-zA-Z][a-zA-Z0-9.:-]*|v-\\S+|:[a-zA-Z][a-zA-Z0-9.:-]*|#[a-zA-Z][a-zA-Z0-9-]*)\\b'
        'name': 'keyword.control.directive.vue'
      }
      {
        'match': '([a-zA-Z-]+)\\s*(=)'
        'captures':
          '1':
            'name': 'entity.other.attribute-name.vue'
          '2':
            'name': 'punctuation.separator.key-value.vue'
      }
      {
        'begin': '"'
        'beginCaptures':
          '0':
            'name': 'punctuation.definition.string.begin.vue'
        'end': '"'
        'endCaptures':
          '0':
            'name': 'punctuation.definition.string.end.vue'
        'name': 'string.quoted.double.vue'
        'patterns': [
          {
            'include': '#mustache'
          }
        ]
      }
      {
        'begin': "'"
        'beginCaptures':
          '0':
            'name': 'punctuation.definition.string.begin.vue'
        'end': "'"
        'endCaptures':
          '0':
            'name': 'punctuation.definition.string.end.vue'
        'name': 'string.quoted.single.vue'
        'patterns': [
          {
            'include': '#mustache'
          }
        ]
      }
    ]
  }
  {
    'include': '#mustache'
  }
  {
    'match': '[<>/]'
    'name': 'punctuation.separator.vue'
  }
]
'repository':
  'mustache':
    'patterns': [
      {
        'begin': '\\{\\{[#/]?'
        'beginCaptures':
          '0':
            'name': 'punctuation.section.mustache.vue'
        'end': '\\}\\}'
        'endCaptures':
          '0':
            'name': 'punctuation.section.mustache.vue'
        'name': 'meta.block.mustache.vue'
        'patterns': [
          {
            'match': '\\b(if|else|unless|each|with|yield|in|as)\\b'
            'name': 'keyword.control.mustache.vue'
          }
          {
            'match': "'(?:\\\\.|[^\\\\'])*'|\"(?:\\\\.|[^\\\\\"])*\""
            'name': 'string.quoted.mustache.vue'
          }
          {
            'match': '\\|\\s*[a-zA-Z_][a-zA-Z0-9_]*(?:\\s*\\([^)]*\\))?'
            'name': 'support.function.filter.mustache.vue'
          }
          {
            'match': '[a-zA-Z_][a-zA-Z0-9_.]*(?!\\w)'
            'name': 'variable.other.mustache.vue'
          }
        ]
      }
    ]